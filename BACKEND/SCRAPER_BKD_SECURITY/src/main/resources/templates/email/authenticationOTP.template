<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>Buzzlyn Authentication Code</title>
  </head>
  <body style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #ffffff;">
    <table cellpadding="0" cellspacing="0" border="0" width="100%">
      <tr>
        <td align="center">
          <table cellpadding="0" cellspacing="0" border="0" width="600" style="background-color: #1F2937; border-radius: 12px; overflow: hidden;">
            <!-- Header -->
            <tr>
              <td align="center" style="padding: 20px; background-color: #111827; border-bottom: 1px solid #374151;">
                <img src="{logo_URL}" alt="Buzzlyn Logo" style="max-height: 60px;">
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 30px 20px; text-align: center;">
                <h1 style="color: #ffffff; margin-bottom: 20px; font-size: 24px; font-weight: normal;">Verify Your Identity</h1>
                <p style="color: #D1D5DB; font-size: 16px; line-height: 1.6; text-align: left; margin-bottom: 20px;">Hello,</p>
                <p style="color: #D1D5DB; font-size: 16px; line-height: 1.6; text-align: left; margin-bottom: 20px;">Please use the verification code below to complete the process:</p>

                <!-- OTP Box -->
                <table width="100%" cellpadding="0" cellspacing="0" style="background: #1E3A8A; background: linear-gradient(135deg, #1E3A8A 0%, #3B82F6 100%); border-radius: 12px; padding: 30px 20px; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3); margin: 30px 0;">
                  <tr>
                    <td align="center" style="padding: 20px;">
                      <table cellpadding="0" cellspacing="0" style="margin: auto;">
                        <tr>
                          <td style="width: 50px; height: 60px; background-color: #ffffff; border-radius: 8px; text-align: center; font-size: 28px; font-weight: bold; color: #1F2937; border: 2px solid #E5E7EB; box-shadow: 0 2px 8px rgba(0,0,0,0.1);"> {1} </td>
                          <td style="width: 8px;"></td>
                          <td style="width: 50px; height: 60px; background-color: #ffffff; border-radius: 8px; text-align: center; font-size: 28px; font-weight: bold; color: #1F2937; border: 2px solid #E5E7EB; box-shadow: 0 2px 8px rgba(0,0,0,0.1);"> {2} </td>
                          <td style="width: 8px;"></td>
                          <td style="width: 50px; height: 60px; background-color: #ffffff; border-radius: 8px; text-align: center; font-size: 28px; font-weight: bold; color: #1F2937; border: 2px solid #E5E7EB; box-shadow: 0 2px 8px rgba(0,0,0,0.1);"> {3} </td>
                          <td style="width: 8px;"></td>
                          <td style="width: 50px; height: 60px; background-color: #ffffff; border-radius: 8px; text-align: center; font-size: 28px; font-weight: bold; color: #1F2937; border: 2px solid #E5E7EB; box-shadow: 0 2px 8px rgba(0,0,0,0.1);"> {4} </td>
                        </tr>
                      </table>
                      <p style="color: #E5E7EB; font-size: 13px; margin: 20px 0 0; opacity: 0.9;">⏰ This code will expire in 5 minutes</p>
                    </td>
                  </tr>
                </table>

                <p style="color: #D1D5DB; font-size: 16px; line-height: 1.6; text-align: left; margin-bottom: 20px;">If you didn't request this code, please ignore this email. Someone may have typed your email address by mistake.</p>

                <!-- Security Note -->
                <table cellpadding="0" cellspacing="0" width="100%" style="background-color: rgba(59, 130, 246, 0.1); border-left: 4px solid #3B82F6; padding: 15px; border-radius: 0 4px 4px 0; margin-top: 20px;">
                  <tr>
                    <td style="text-align: left; color: #D1D5DB; font-size: 14px;">
                      <strong>🔒 Security Tip:</strong> Buzzlyn will never ask you to share this code with anyone, including our support team. If someone is asking for your code, it's likely a scam.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding: 20px; text-align: center; font-size: 12px; color: #6B7280; border-top: 1px solid #374151;">
                &copy; Buzzlyn | This is an automated message, please do not reply.<br>
                If you need assistance, contact us at <a href="mailto:support@buzzlyn.com" style="color: #6B7280; text-decoration: underline;">support@buzzlyn.com</a>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
