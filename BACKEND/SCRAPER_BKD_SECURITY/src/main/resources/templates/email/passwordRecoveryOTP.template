<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Buzzlyn Password Reset Code</title>
</head>
<body style="margin:0; padding:0; font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color:#ffffff;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" border="0" style="background-color:#1F2937; border-radius:12px; overflow:hidden; box-shadow:0 0 10px rgba(0,0,0,0.2);">
          <!-- Header -->
          <tr>
            <td align="center" style="padding:20px; background-color:#111827; border-bottom:1px solid #374151;">
              <img src="{logo_URL}" alt="Buzzlyn Logo" style="max-height:60px;">
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:30px 20px; text-align:center;">
              <h1 style="color:#ffffff; font-size:24px; margin-bottom:20px;">Password Reset Request</h1>
              <p style="color:#D1D5DB; font-size:16px; line-height:1.6; text-align:left; margin-bottom:20px;">
                Hello,<br><br>
                We received a request to reset your Buzzlyn account password. To proceed with the password reset, please use the verification code below:
              </p>

              <!-- OTP Code -->
              <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background: linear-gradient(135deg, #1E3A8A 0%, #3B82F6 100%); border-radius:12px; margin:30px 0; box-shadow:0 4px 15px rgba(59,130,246,0.3); padding:20px;">
                <tr>
                  <td align="center" style="padding:20px;">
                    <table cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="width:50px; height:60px; background-color:#ffffff; border-radius:8px; font-size:28px; font-weight:bold; color:#1F2937; text-align:center; vertical-align:middle; border:2px solid #E5E7EB;">{1}</td>
                        <td width="8"></td>
                        <td style="width:50px; height:60px; background-color:#ffffff; border-radius:8px; font-size:28px; font-weight:bold; color:#1F2937; text-align:center; vertical-align:middle; border:2px solid #E5E7EB;">{2}</td>
                        <td width="8"></td>
                        <td style="width:50px; height:60px; background-color:#ffffff; border-radius:8px; font-size:28px; font-weight:bold; color:#1F2937; text-align:center; vertical-align:middle; border:2px solid #E5E7EB;">{3}</td>
                        <td width="8"></td>
                        <td style="width:50px; height:60px; background-color:#ffffff; border-radius:8px; font-size:28px; font-weight:bold; color:#1F2937; text-align:center; vertical-align:middle; border:2px solid #E5E7EB;">{4}</td>
                      </tr>
                    </table>
                    <p style="color:#E5E7EB; font-size:13px; margin-top:20px;">⏰ This code will expire in 5 minutes</p>
                  </td>
                </tr>
              </table>

              <!-- Warning Box -->
              <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:rgba(239,68,68,0.1); border-left:4px solid #EF4444; border-radius:0 4px 4px 0; padding:15px; margin:20px 0;">
                <tr>
                  <td style="padding:15px;">
                    <p style="color:#D1D5DB; font-size:16px; margin:0;">
                      <strong>⚠️ Important:</strong> If you didn't request a password reset, please contact our support team immediately at <a href="mailto:support@buzzlyn.com" style="color:#3B82F6;">support@buzzlyn.com</a> as your account may be at risk.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="color:#D1D5DB; font-size:16px; line-height:1.6; text-align:left; margin-top:20px;">
                For security reasons, this password reset code will expire in 5 minutes. If you need a new code, you can request another password reset.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:20px; text-align:center; font-size:12px; color:#6B7280; border-top:1px solid #374151;">
              &copy; Buzzlyn | This is an automated message, please do not reply.<br>
              If you need assistance, contact us at <a href="mailto:support@buzzlyn.com" style="color:#6B7280;">support@buzzlyn.com</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
