# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=scraper
MYSQL_USER=pricetracker
MYSQL_PASSWORD=change_me

# JWT / App
JWT_SECRET=change_me_jwt
MY_JWT_SECRET=change_me_jwt

# OAuth2 (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/login/oauth2/code/google

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+10000000000

# External APIs
BREVO_API_KEY=your-brevo-key
BREVO_USERNAME=your-brevo-username
BREVO_PASSWORD=your-brevo-password
WEBPUSH_PUBLIC_KEY=your-vapid-public-key
WEBPUSH_PRIVATE_KEY=your-vapid-private-key
WEBPUSH_MAIL=notify@example.com
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
GEMINI_API_KEY=your-gemini-api-key
SCRAPER_API_KEY=your-scraper-api-key

# Scraper helpers
PYTHON_SCRAPER_SECRETKEY=change_me_scraper_key
ZENROWS_SERVER=
ZENROWS_USERNAME=
ZENROWS_PASSWORD=
WEBSHARE_SERVER=
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=

# Frontend / Vite
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Mail
MAILJEY_API_KEY=your-mailjet-key
MAILJEY_API_SECRET=your-mailjet-secret
MAILJEY_SENDER_EMAIL=sender@example.com

# Other
SERVER_MAX_HTTP_HEADER_SIZE=16384
